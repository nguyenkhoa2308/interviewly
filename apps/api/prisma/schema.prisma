generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ExperienceLevel {
  INTERN
  FRESHER
  JUNIOR
  MIDDLE
  SENIOR
  LEAD

  @@map("experience_level_enum")
}

enum Language {
  VI
  EN

  @@map("language_enum")
}

enum InterviewType {
  HR
  BEHAVIORAL
  TECHNICAL
  CODING
  SYSTEM_DESIGN
  FULL

  @@map("interview_type_enum")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  ADAPTIVE

  @@map("difficulty_enum")
}

enum InterviewerStyle {
  FRIENDLY
  PROFESSIONAL
  STRICT

  @@map("interviewer_style_enum")
}

enum SkillLevel {
  BEGINNER
  BASIC
  INTERMEDIATE
  ADVANCED
  EXPERT

  @@map("skill_level_enum")
}

enum Theme {
  LIGHT
  DARK
  SYSTEM

  @@map("theme_enum")
}

enum InteractionMode {
  TEXT
  VOICE

  @@map("interaction_mode_enum")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum OAuthProvider {
  GOOGLE
}

enum InterviewGoal {
  GET_A_JOB
  IMPROVE_SKILLS
  CRACK_TOP_COMPANIES
  SWITCH_CAREER
  BOOST_INTERVIEW_CONFIDENCE
  IMPROVE_RESUME
  PRACTICE_COMMUNICATION
  OTHER
}

enum LearningStyle {
  LEARN_BY_DOING
  LEARN_BY_READING
  LEARN_BY_WATCHING
  MIXED
}

enum ContentPreference {
  DATA_STRUCTURES_ALGORITHMS
  SYSTEM_DESIGN
  FRONTEND_FRAMEWORKS
  BEHAVIORAL_QUESTIONS
  CODING_CHALLENGES
  RESUME_PORTFOLIO
}

enum FeedbackDetail {
  CONCISE
  STANDARD
  DETAILED
}

enum CVProcessingStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED

  @@map("cv_processing_status_enum")
}

enum CVAnalysisStatus {
  PROCESSING
  COMPLETED
  FAILED

  @@map("cv_analysis_status_enum")
}

enum JDAnalysisStatus {
  PROCESSING
  COMPLETED
  FAILED

  @@map("jd_analysis_status_enum")
}

enum CVJDMatchStatus {
  PROCESSING
  COMPLETED
  FAILED

  @@map("cv_jd_match_status_enum")
}

model User {
  id                    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                 String     @unique @db.VarChar(255)
  passwordHash          String?    @map("password_hash")
  fullName              String     @map("full_name") @db.VarChar(150)
  avatarUrl             String?    @map("avatar_url")
  emailVerifiedAt       DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  onboardingCompletedAt DateTime?  @map("onboarding_completed_at") @db.Timestamptz(6)
  role                  UserRole   @default(USER)
  status                UserStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  oauthAccounts       OAuthAccount[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  preference          UserPreference?
  settings            UserSetting?
  skills              UserSkill[]
  emailVerifications  EmailVerification[]
  cvs                 CV[]
  jobDescriptions     JobDescription[]
  cvJdMatches         CVJDMatch[]

  @@index([deletedAt])
  @@map("users")
}

model OAuthAccount {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model Session {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String @map("user_id") @db.Uuid
  refreshTokenHash String @map("refresh_token_hash")

  userAgent String? @map("user_agent")
  ipAddress String? @map("ip_address") @db.VarChar(45)

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model UserPreference {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  targetRole        String?          @map("target_role") @db.VarChar(100)
  experienceLevel   ExperienceLevel? @map("experience_level")
  yearsOfExperience Decimal?         @map("years_of_experience") @db.Decimal(4, 1)

  interviewGoals      InterviewGoal[] @default([]) @map("interview_goals")
  customInterviewGoal String?         @map("custom_interview_goal") @db.VarChar(255)

  learningStyle      LearningStyle?      @map("learning_style")
  contentPreferences ContentPreference[] @default([]) @map("content_preferences")
  defaultDifficulty  Difficulty?         @map("default_difficulty")
  feedbackDetail     FeedbackDetail?     @map("feedback_detail")

  preferredLanguage    Language          @default(VI) @map("preferred_language")
  defaultInterviewType InterviewType?    @map("default_interview_type")
  interviewerStyle     InterviewerStyle? @map("interviewer_style")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UserSetting {
  id                     String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String          @unique @map("user_id") @db.Uuid
  theme                  Theme           @default(SYSTEM)
  timezone               String?         @db.VarChar(100)
  defaultInteractionMode InteractionMode @default(TEXT) @map("default_interaction_mode")
  defaultDurationMinutes Int             @default(30) @map("default_duration_minutes")
  voiceName              String?         @map("voice_name") @db.VarChar(100)
  speechSpeed            Decimal         @default(1) @map("speech_speed") @db.Decimal(4, 2)
  volume                 Decimal         @default(1) @db.Decimal(4, 2)
  saveInterviewAudio     Boolean         @default(false) @map("save_interview_audio")
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Skill {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  category    String?  @db.VarChar(100)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  users UserSkill[]

  @@index([category])
  @@index([isActive])
  @@map("skills")
}

model UserSkill {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String      @map("user_id") @db.Uuid
  skillId           String      @map("skill_id") @db.Uuid
  selfLevel         SkillLevel? @map("self_level")
  yearsOfExperience Decimal?    @map("years_of_experience") @db.Decimal(4, 1)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([userId, skillId])
  @@index([skillId])
  @@map("user_skills")
}

model EmailVerification {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  codeHash String @map("code_hash")
  attempts Int    @default(0)

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verifications")
}

model CV {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String             @map("user_id") @db.Uuid
  currentVersionId    String?            @unique @map("current_version_id") @db.Uuid
  name                String             @db.VarChar(150)
  originalFilename    String             @map("original_filename") @db.VarChar(255)
  storageKey          String             @unique @map("storage_key")
  mimeType            String             @map("mime_type") @db.VarChar(100)
  fileSize            Int?               @map("file_size")
  extractedText       String?            @map("extracted_text")
  structuredContent   Json?              @map("structured_content")
  processingStatus    CVProcessingStatus @default(UPLOADING) @map("processing_status")
  processingErrorCode String?            @map("processing_error_code") @db.VarChar(100)
  processingError     String?            @map("processing_error")
  isDefault           Boolean            @default(false) @map("is_default")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?          @map("deleted_at") @db.Timestamptz(6)

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses       CVAnalysis[]
  versions       CVVersion[]  @relation("CVVersions")
  currentVersion CVVersion?   @relation("CurrentCVVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  matches        CVJDMatch[]

  @@index([userId, deletedAt])
  @@index([userId, processingStatus])
  @@map("cvs")
}

model CVVersion {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cvId                String             @map("cv_id") @db.Uuid
  versionNumber       Int                @map("version_number")
  originalFilename    String             @map("original_filename") @db.VarChar(255)
  storageKey          String             @unique @map("storage_key")
  mimeType            String             @map("mime_type") @db.VarChar(100)
  fileSize            Int?               @map("file_size")
  extractedText       String?            @map("extracted_text")
  structuredContent   Json?              @map("structured_content")
  processingStatus    CVProcessingStatus @default(UPLOADING) @map("processing_status")
  processingErrorCode String?            @map("processing_error_code") @db.VarChar(100)
  processingError     String?            @map("processing_error")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  cv         CV           @relation("CVVersions", fields: [cvId], references: [id], onDelete: Cascade)
  currentFor CV?          @relation("CurrentCVVersion")
  analyses   CVAnalysis[]
  matches    CVJDMatch[]

  @@unique([cvId, versionNumber])
  @@index([cvId, createdAt(sort: Desc)])
  @@index([cvId, processingStatus])
  @@map("cv_versions")
}

model CVAnalysis {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cvId        String           @map("cv_id") @db.Uuid
  cvVersionId String?          @map("cv_version_id") @db.Uuid
  status      CVAnalysisStatus @default(PROCESSING)

  overallScore  Decimal?         @map("overall_score") @db.Decimal(5, 2)
  detectedRole  String?          @map("detected_role") @db.VarChar(150)
  detectedLevel ExperienceLevel? @map("detected_level")

  extractedSkills    Json? @map("extracted_skills")
  workExperiences    Json? @map("work_experiences")
  projects           Json?
  education          Json?
  strengths          Json?
  weaknesses         Json?
  interviewRisks     Json? @map("interview_risks")
  potentialQuestions Json? @map("potential_questions")
  suggestions        Json?

  modelProvider String? @map("model_provider") @db.VarChar(100)
  modelName     String? @map("model_name") @db.VarChar(150)
  promptVersion String? @map("prompt_version") @db.VarChar(50)

  errorCode    String? @map("error_code") @db.VarChar(100)
  errorMessage String? @map("error_message")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  cv        CV          @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvVersion CVVersion?  @relation(fields: [cvVersionId], references: [id], onDelete: Cascade)
  matches   CVJDMatch[]

  @@index([cvId, createdAt(sort: Desc)])
  @@index([cvId, status])
  @@index([cvVersionId, createdAt(sort: Desc)])
  @@index([cvVersionId, status])
  @@map("cv_analyses")
}

model JobDescription {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String    @db.VarChar(150)
  company   String?   @db.VarChar(150)
  content   String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses JDAnalysis[]
  matches  CVJDMatch[]

  @@index([userId, deletedAt, createdAt(sort: Desc)])
  @@map("job_descriptions")
}

model JDAnalysis {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobDescriptionId String           @map("job_description_id") @db.Uuid
  status           JDAnalysisStatus @default(PROCESSING)
  detectedRole     String?          @map("detected_role") @db.VarChar(150)
  seniority        String?          @db.VarChar(100)
  summary          String?
  requiredSkills   Json?            @map("required_skills")
  preferredSkills  Json?            @map("preferred_skills")
  responsibilities Json?
  requirements     Json?
  keywords         Json?
  interviewFocus   Json?            @map("interview_focus")
  insights         Json?
  modelProvider    String?          @map("model_provider") @db.VarChar(100)
  modelName        String?          @map("model_name") @db.VarChar(150)
  promptVersion    String?          @map("prompt_version") @db.VarChar(50)
  errorCode        String?          @map("error_code") @db.VarChar(100)
  errorMessage     String?          @map("error_message")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt      DateTime?        @map("completed_at") @db.Timestamptz(6)

  jobDescription JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  matches        CVJDMatch[]

  @@index([jobDescriptionId, createdAt(sort: Desc)])
  @@index([jobDescriptionId, status])
  @@map("jd_analyses")
}

model CVJDMatch {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  cvId             String          @map("cv_id") @db.Uuid
  cvVersionId      String          @map("cv_version_id") @db.Uuid
  cvAnalysisId     String          @map("cv_analysis_id") @db.Uuid
  jobDescriptionId String          @map("job_description_id") @db.Uuid
  jdAnalysisId     String          @map("jd_analysis_id") @db.Uuid
  status           CVJDMatchStatus @default(PROCESSING)

  cvNameSnapshot    String  @map("cv_name_snapshot") @db.VarChar(150)
  cvVersionNumber   Int     @map("cv_version_number")
  jdTitleSnapshot   String  @map("jd_title_snapshot") @db.VarChar(150)
  jdCompanySnapshot  String?   @map("jd_company_snapshot") @db.VarChar(150)
  cvUpdatedAtSnapshot DateTime  @map("cv_updated_at_snapshot") @db.Timestamptz(6)
  jdUpdatedAtSnapshot DateTime  @map("jd_updated_at_snapshot") @db.Timestamptz(6)

  matchScore          Decimal? @map("match_score") @db.Decimal(5, 2)
  scoreBreakdown      Json?    @map("score_breakdown")
  matchSummary        String?  @map("match_summary")
  matchedSkills       Json?    @map("matched_skills")
  skillGaps           Json?    @map("skill_gaps")
  strengths           Json?
  gaps                Json?
  experienceAlignment Json?    @map("experience_alignment")
  recommendations     Json?

  modelProvider String?   @map("model_provider") @db.VarChar(100)
  modelName     String?   @map("model_name") @db.VarChar(150)
  promptVersion String?   @map("prompt_version") @db.VarChar(50)
  errorCode     String?   @map("error_code") @db.VarChar(100)
  errorMessage  String?   @map("error_message")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  cv             CV             @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvVersion      CVVersion      @relation(fields: [cvVersionId], references: [id], onDelete: Cascade)
  cvAnalysis     CVAnalysis     @relation(fields: [cvAnalysisId], references: [id], onDelete: Cascade)
  jobDescription JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  jdAnalysis     JDAnalysis     @relation(fields: [jdAnalysisId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, cvId, jobDescriptionId, createdAt(sort: Desc)])
  @@index([cvAnalysisId, jdAnalysisId, status])
  @@map("cv_jd_matches")
}
